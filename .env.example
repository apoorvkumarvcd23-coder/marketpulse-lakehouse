# Copy this file to .env for local development. Never put real cloud or exchange
# credentials in this example file, and never commit your copied .env file.

MARKETPULSE_ENVIRONMENT=development
MARKETPULSE_LOG_LEVEL=INFO
MARKETPULSE_DATA_DIR=data

MARKETPULSE_POSTGRES_HOST=127.0.0.1
MARKETPULSE_POSTGRES_PORT=5432
MARKETPULSE_POSTGRES_DB=marketpulse
MARKETPULSE_POSTGRES_USER=marketpulse
MARKETPULSE_POSTGRES_PASSWORD=change-this-local-password
